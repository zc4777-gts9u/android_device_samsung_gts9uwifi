cc_library_static {
    name: "libgts9u_speaker_dolby",
    vendor: true,
    srcs: ["SpeakerDolby.cpp"],
    export_include_dirs: ["include"],
    header_libs: [
        "libaudio_system_headers",
        "libaudioutils_headers",
        "libhardware_headers",
    ],
    shared_libs: [
        "libaudioutils",
        "libdl",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    visibility: ["//device/samsung/sm8550-common/audio/impl:__pkg__"],
}
