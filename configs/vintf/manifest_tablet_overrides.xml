<!-- The tablet provides no Lineage touch HAL; its touch and pen input use
     the kernel input devices and the independent Samsung S Pen service. -->
<manifest version="5.0" type="device">
    <hal format="aidl" override="true">
        <name>vendor.lineage.touch</name>
    </hal>
    <!-- The Wi-Fi tablet has no embedded Secure Element. -->
    <hal format="hidl" override="true">
        <name>android.hardware.secure_element</name>
        <transport>hwbinder</transport>
    </hal>
    <!-- CYG1's Wi-Fi-only manifest disables both IPA tether offload interfaces. -->
    <hal format="hidl" override="true">
        <name>android.hardware.tetheroffload.config</name>
        <transport>hwbinder</transport>
    </hal>
    <hal format="hidl" override="true">
        <name>android.hardware.tetheroffload.control</name>
        <transport>hwbinder</transport>
    </hal>
</manifest>
