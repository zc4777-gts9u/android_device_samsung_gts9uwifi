soong_namespace {
}

install_symlink {
    name: "spen_firmware_early_symlink",
    vendor: true,
    installed_location: "firmware/early/wez01_gts9u.bin",
    symlink_target: "/vendor/firmware/wez01_gts9u.bin",
}

install_symlink {
    name: "firmware_wlanmdsp.otaupdate_symlink",
    vendor: true,
    installed_location: "firmware/wlanmdsp.otaupdate",
    symlink_target: "/data/vendor/firmware/wlanmdsp.mbn",
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6490/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/qca6490/wlan_mac.bin",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6490/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/qca6490/WCNSS_qcom_cfg.ini",
}

install_symlink {
    name: "firmware_wlan_mac.bin_kiwi_v2_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/kiwi_v2/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/kiwi_v2/wlan_mac.bin",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_kiwi_v2_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/kiwi_v2/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/kiwi_v2/WCNSS_qcom_cfg.ini",
}

// Share the device partition layout with the common vendor fstab module.
filegroup {
    name: "fstab.gts9uwifi.source",
    srcs: ["init/fstab.qcom"],
    visibility: ["//visibility:public"],
}
